# Public build-time config for the Cloudflare (OpenNext) production build.
#
# NEXT_PUBLIC_* values are INLINED into the client bundle during `next build`,
# so they must exist at build time. Committing them here makes the build
# reproducible and independent of the dashboard "Build variables" — which get
# wiped whenever the Git repo is disconnected/reconnected. Every value here is
# PUBLIC by design (the publishable key ships in the browser bundle anyway).
#
# SECRETS DO NOT GO HERE. CLERK_SECRET_KEY is a runtime secret set via
# `wrangler secret put CLERK_SECRET_KEY` — never committed.
NEXT_PUBLIC_APP_NAME=Ekcron
NEXT_PUBLIC_API_URL=https://api.ekcron.com
NEXT_PUBLIC_MARKETING_URL=https://ekcron.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZWtjcm9uLmNvbSQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
