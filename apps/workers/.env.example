# ===========================================
# Python Workers Environment Variables
# Copy to .env for local development
# ===========================================
# All vars use APP_ prefix (see config.py WorkerSettings)

# Temporal
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TEMPORAL_TASK_QUEUE=ml-pipeline

# Database (PostgreSQL — same instance as API)
APP_DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/platform

# Redis
APP_REDIS_URL=redis://localhost:6379

# S3 / Object Storage
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=platform-dev
APP_S3_REGION=us-east-1

# LLM API — platform-wide defaults
# Per-tenant settings (configured via Settings > LLM Provider in the UI)
# take priority over these defaults.
APP_LLM_API_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=sk-your-key-here
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_MAX_TOKENS=2000

# Platform API (for worker → API callbacks like deploy notifications)
APP_PLATFORM_API_URL=http://localhost:8000
APP_PLATFORM_INTERNAL_TOKEN=

# vLLM inference server (for deployed model serving)
APP_VLLM_API_URL=http://localhost:8080

# HuggingFace token (for downloading base models during training)
APP_HF_TOKEN=hf_your_token_here

# Training
APP_MODEL_CACHE_DIR=/tmp/model_cache
APP_WORKER_MODE=all          # all | main | gpu

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text           # json (production) | text (local dev)

# Observability
APP_OTEL_ENABLED=false
APP_OTEL_ENDPOINT=http://localhost:4317

# Circuit breaker
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAIL_MAX=5
APP_CIRCUIT_BREAKER_RESET_TIMEOUT=30
