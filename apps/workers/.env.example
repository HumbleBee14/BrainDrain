# ===========================================
# Python Workers Environment Variables
# Copy to .env for local development
# ===========================================
# All vars use APP_ prefix (see config.py WorkerSettings)

# Temporal
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TEMPORAL_TASK_QUEUE=ml-pipeline

# Database (PostgreSQL — same instance as API)
APP_DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/platform
APP_DB_POOL_MIN=2
APP_DB_POOL_MAX=10

# Redis
APP_REDIS_URL=redis://localhost:6379

# S3 / Object Storage — any S3-compatible store works (see src/s3_client.py).
#   Local dev (MinIO): endpoint http://localhost:9000, region us-east-1
#   AWS S3           : endpoint "" (empty) or regional, region = real region
#   Cloudflare R2    : endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto
#                      (free tier + free egress; reachable from Modal, unlike localhost MinIO)
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=platform-dev
APP_S3_REGION=us-east-1

# LLM API — platform-wide defaults
# Per-tenant settings (configured via Settings > LLM Provider in the UI)
# take priority over these defaults.
APP_LLM_API_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=sk-your-key-here
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_MAX_TOKENS=2000

# Platform API (for worker → API callbacks like deploy notifications)
APP_PLATFORM_API_URL=http://localhost:8000
APP_PLATFORM_INTERNAL_TOKEN=

# Decrypts tenant LLM API keys stored as enc:v1:... in the database
# (AES-256-GCM, base64-encoded 32 bytes; generate: openssl rand -base64 32).
# Must be the SAME value as the API's SETTINGS_ENCRYPTION_KEY.
APP_SETTINGS_ENCRYPTION_KEY=

# vLLM inference server (for deployed model serving)
APP_VLLM_API_URL=http://localhost:8080

# HuggingFace token (for downloading base models during training)
APP_HF_TOKEN=hf_your_token_here

# Training
APP_MODEL_CACHE_DIR=/tmp/model_cache
APP_WORKER_MODE=all          # all | main | gpu

# GPU compute provider: "local" (worker's own GPU) | "modal" (serverless)
APP_GPU_PROVIDER=local
# Modal credentials (only needed when APP_GPU_PROVIDER=modal)
# Get tokens at: https://modal.com/settings
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ===========================================
# Backend Selection — swap processing layers without code changes
# Each backend is a named entry in a registry. All default to the
# current behaviour; change only what you need.
# ===========================================

# PDF extraction backend: "pymupdf" (default, fast) | "docling" (richer structure)
# Install docling first: pip install platform-workers[pdf-ml]
APP_PDF_BACKEND=pymupdf

# Language detection backend: "langdetect" (default) | "null" (disable)
APP_LANGUAGE_DETECTOR_BACKEND=langdetect

# Training engine: "unsloth" (default, fast LoRA)
# Register custom engines via register_engine() in training_engine.py
APP_TRAINING_ENGINE=unsloth

# Training metrics sink: "redis" (default, real-time dashboard) | "log" | "null"
# Use "log" locally if you have no Redis, "null" to silence metrics entirely
APP_METRICS_BACKEND=redis

# Evaluation model loader: "unsloth" (default)
APP_EVAL_MODEL_LOADER=unsloth

# Text chunking strategy: "recursive" (default, paragraph→sentence) | "sliding" (fixed window)
APP_CHUNKING_BACKEND=recursive

# LLM provider for synthetic data generation: "openai" (default, any OpenAI-compatible)
APP_LLM_PROVIDER_BACKEND=openai

# Dataset quality filter: "heuristic" (default, length-based rules)
APP_DATASET_FILTER_BACKEND=heuristic

# Deduplication strategy: "hash" (default, MD5 content hash)
APP_DEDUP_BACKEND=hash

# LLM judge for evaluation: "openai" (default, any OpenAI-compatible)
APP_JUDGE_BACKEND=openai

# Judge resilience: retry transient errors this many times, then act per
# APP_JUDGE_ON_FAILURE — "error" fails loud (default), "heuristic" falls back.
APP_JUDGE_MAX_RETRIES=3
APP_JUDGE_ON_FAILURE=error

# Data Studio synthetic-data-generation backends (all default to "llm").
APP_DATAGEN_FACET_BACKEND=llm
APP_DATAGEN_PAIR_BACKEND=llm
APP_DATAGEN_REFINER_BACKEND=llm
APP_DATAGEN_FAITHFULNESS_BACKEND=llm

# ===========================================
# Data Studio synthetic-data generation
# ===========================================
# Drop generated pairs whose response isn't grounded in the source chunk.
APP_FAITHFULNESS_GATE_ENABLED=true
# Sampling temperatures: generation is creative; the faithfulness judge is
# scored near-deterministically for stable verdicts.
APP_GENERATION_TEMPERATURE=0.7
APP_JUDGE_TEMPERATURE=0.0
# Checkpoint each chunk's finished pairs to S3 so a mid-run failure resumes.
APP_PAIR_CHECKPOINT_ENABLED=true

# ===========================================
# Activity timeouts — increase for slow hardware or very large models
# ===========================================
APP_TIMEOUT_PARSE_MINUTES=10
APP_TIMEOUT_CHUNK_MINUTES=10
APP_TIMEOUT_GENERATE_PAIRS_MINUTES=30
APP_TIMEOUT_BUILD_DATASET_MINUTES=15
APP_TIMEOUT_TRAIN_HOURS=6
APP_TIMEOUT_TRAIN_ITERATIVE_HOURS=4
APP_TIMEOUT_HOLDOUT_EVAL_HOURS=1
APP_TIMEOUT_EVAL_HOURS=1
APP_TIMEOUT_EXPORT_HOURS=2
APP_TIMEOUT_DATAGEN_INTERACTIVE_MINUTES=5

# ===========================================
# Billing
# ===========================================
# Failed training jobs shorter than this are voided (not billed).
APP_MIN_BILLABLE_SECONDS=300

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text           # json (production) | text (local dev)

# Observability
APP_OTEL_ENABLED=false
APP_OTEL_ENDPOINT=http://localhost:4317

# Circuit breaker
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAIL_MAX=5
APP_CIRCUIT_BREAKER_RESET_TIMEOUT=30

# Cloud GPU (Modal) — only used when APP_GPU_PROVIDER=modal
APP_MODAL_APP_NAME=platform-training
APP_MODAL_FUNCTION_NAME=train
# Names of the other deployed Modal functions (one per GPU-bound activity).
APP_MODAL_SFT_ROUND_FUNCTION_NAME=train_sft_round
APP_MODAL_EVALUATE_HOLDOUT_FUNCTION_NAME=evaluate_holdout
APP_MODAL_EVALUATION_FUNCTION_NAME=run_evaluation
APP_MODAL_SECRET_NAME=platform-training-secrets
APP_MODAL_POLL_INTERVAL_SECS=15
