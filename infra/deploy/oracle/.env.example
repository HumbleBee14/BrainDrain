# Copy to .env on the box (gitignored) and fill in. Values mirror the managed
# services (Neon / Upstash / R2 / Modal / Clerk).

# Database (Neon). RLS URL uses the least-privilege app_rls role.
DATABASE_URL=
DATABASE_RLS_URL=
APP_DATABASE_URL=

# Redis (Upstash, rediss://).
REDIS_URL=

# Object storage (R2).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto

# Tenant-secret encryption (32-byte base64). API encrypts, workers decrypt — same value.
SETTINGS_ENCRYPTION_KEY=

# Auth (Clerk).
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=

# Temporal's own Postgres (runs on the box).
TEMPORAL_DB_PASSWORD=

# Modal (GPU training).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

CORS_ORIGINS=https://app.ekcron.com

# Serving engine. INFERENCE_API_KEY must match VLLM_API_KEY in the Modal secret;
# blank on both sides leaves the engine unauthenticated.
INFERENCE_BACKEND_TYPE=vllm
INFERENCE_SERVER_URL=
INFERENCE_API_KEY=

# Leave blank: no platform default key, so data-gen requires a tenant's own key.
APP_LLM_API_KEY=
