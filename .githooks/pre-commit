#!/usr/bin/env bash
# Pre-commit hook: auto-format and check for drift before every commit.
# Install: git config core.hooksPath .githooks
# Or:      make setup-hooks

# Ensure cargo/rustup and common tools are in PATH.
# VSCode and GUI git clients don't load shell profiles.
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

set -e

# Prefer native Windows executables when the hook runs under Git Bash / GitHub
# Desktop, but keep normal command resolution on Linux/macOS.
find_bin() {
    for candidate in "$@"; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

restage_matching_files() {
    pattern="$1"
    git diff --cached --name-only --diff-filter=ACM | while IFS= read -r file; do
        case "$file" in
            $pattern) git add "$file" ;;
        esac
    done
}

CARGO_BIN="$(find_bin cargo.exe cargo)"
PYTHON_BIN="$(find_bin python.exe python python3)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Rust formatting
if git diff --cached --name-only | grep -q '\.rs$'; then
    if [ -z "$CARGO_BIN" ]; then
        echo -e "  ${RED}Rust: cargo not found in PATH${NC}"
        exit 1
    fi

    echo -e "  Rust: cargo fmt"
    if ! "$CARGO_BIN" fmt --all -- --check 2>/dev/null; then
        echo -e "  ${YELLOW}Rust: auto-formatting...${NC}"
        "$CARGO_BIN" fmt --all
        restage_matching_files '*.rs'
        echo -e "  ${GREEN}Rust: formatted and re-staged${NC}"
    fi

    echo -e "  Rust: cargo clippy"
    if ! "$CARGO_BIN" clippy --all-targets --all-features -- -D warnings; then
        echo -e "  ${RED}Rust: clippy failed - fix before committing${NC}"
        exit 1
    fi
fi

# Python formatting
if git diff --cached --name-only | grep -q '\.py$'; then
    echo -e "  Python: ruff format"
    CHANGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
    if [ -n "$CHANGED_PY" ]; then
        (cd apps/workers && uv run ruff format $CHANGED_PY 2>/dev/null) || true
        echo "$CHANGED_PY" | while IFS= read -r file; do
            [ -n "$file" ] && git add "$file"
        done
        echo -e "  ${GREEN}Python: formatted and re-staged${NC}"

        (cd apps/workers && uv run ruff check src/ 2>/dev/null) || {
            echo -e "  ${RED}Python: ruff check found issues (see above)${NC}"
            exit 1
        }
    fi
fi

# Frontend formatting
if git diff --cached --name-only | grep -qE '\.(ts|tsx|js|jsx)$'; then
    echo -e "  Frontend: checking types"
    # Only type-check, don't block on it (can be slow)
fi

# Rust/Python constant sync
if git diff --cached --name-only | grep -qE '(constants\.rs|enums\.rs|constants\.py|sync_constants\.py)'; then
    if [ -z "$PYTHON_BIN" ]; then
        echo -e "  ${RED}Sync: python not found in PATH${NC}"
        exit 1
    fi

    echo -e "  Sync: checking Rust/Python constant drift"
    "$PYTHON_BIN" scripts/sync_constants.py --check 2>/dev/null
    if [ $? -ne 0 ]; then
        echo -e "  ${YELLOW}Sync: auto-syncing constants...${NC}"
        "$PYTHON_BIN" scripts/sync_constants.py
        git add apps/workers/src/constants.py
        echo -e "  ${GREEN}Sync: constants synced and re-staged${NC}"
    fi
fi

echo -e "${GREEN}Pre-commit checks passed!${NC}"
