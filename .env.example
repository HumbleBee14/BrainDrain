# ===========================================
# Platform — Master Environment Variables
# Copy to .env and fill in values
# ===========================================
#
# This file documents EVERY env var across all services.
# For local dev, copy this to .env at the project root.
# For production, inject these as environment variables
# into each container (see docker-compose.prod.yml).

# ───────────────────────────────────────────
# 1. API SERVER (Rust — crates/api)
# ───────────────────────────────────────────

# App identity
APP_NAME=MyApp
ENVIRONMENT=development     # development | staging | production
LOG_LEVEL=debug             # trace | debug | info | warn | error
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
# DATABASE_URL is the owner/admin connection: runs migrations, partition DDL,
# and cross-tenant maintenance. It bypasses Row-Level Security.
DATABASE_URL=postgres://platform:platform_dev@localhost:5432/platform
# DATABASE_RLS_URL is the least-privilege `app_rls` connection that carries all
# tenant request traffic and IS subject to Row-Level Security (defense in depth
# on top of WHERE tenant_id). The `app_rls` role is created by migration 017.
# In production, provision this role with a STRONG password before migrating and
# point this at it. If unset, tenant traffic falls back to the owner connection
# and the RLS second layer is inactive (a startup warning is emitted).
DATABASE_RLS_URL=postgres://app_rls:app_rls_dev_password@localhost:5432/platform
DATABASE_MAX_CONNECTIONS=20
DB_PASSWORD=platform_dev        # owner role password; used by docker-compose.prod.yml
# app_rls role password — used by docker-compose.prod.yml to build DATABASE_RLS_URL.
# In production, CREATE this role with this password BEFORE running migrations
# (see docs/DEVELOPMENT.md → "Database roles & tenant isolation"). Dev doesn't
# need it: DATABASE_RLS_URL above already embeds the dev password.
APP_RLS_PASSWORD=app_rls_dev_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# S3 / Object Storage
# For local dev: MinIO. For production: AWS S3 or Cloudflare R2.
# Set S3_ENDPOINT="" (empty) to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=platform-dev
S3_REGION=us-east-1

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Inference backend
INFERENCE_BACKEND_TYPE=vllm         # vllm | tgi | sglang
INFERENCE_SERVER_URL=http://localhost:8080
VLLM_MAX_LORAS=4

# vLLM circuit breaker
VLLM_CB_FAILURE_THRESHOLD=5
VLLM_CB_RECOVERY_TIMEOUT_SECS=30

# Inference limits
INFERENCE_MAX_TOKENS=8192          # hard cap on max_tokens per request (GPU abuse prevention)

# Operational knobs
BILLING_CHANNEL_CAPACITY=10000
BILLING_BATCH_SIZE=1000
BILLING_FLUSH_INTERVAL_SECS=5
DELIVERY_POLL_INTERVAL_SECS=10
DEPLOY_STALE_MINUTES=10
INFERENCE_INSTANCE_HEALTH_POLL_INTERVAL_SECS=60
INFERENCE_INSTANCE_RECONCILE_INTERVAL_SECS=60

# Background reapers (recover abandoned/idle resources)
REAPER_POLL_INTERVAL_SECS=300              # how often the reaper loop runs
TRAINING_STUCK_TIMEOUT_SECS=3600           # training job with no live workflow this long -> failed + billed
PARSING_STUCK_TIMEOUT_SECS=1800            # document stuck in parsing this long -> failed
INFERENCE_INSTANCE_IDLE_TIMEOUT_SECS=0     # idle serving instance scaled to zero after this; 0 disables
ORPHANED_DOCUMENT_SWEEP_SECS=604800        # delete failed docs' source objects after this; 0 disables

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=200

# Security headers
SECURITY_CSP_POLICY=default-src 'self'
SECURITY_HSTS_MAX_AGE=31536000

# Stripe billing (optional — leave empty to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Email (SMTP) — point at an existing email provider; we do NOT run a mail
# server. Works with any SMTP provider by changing these values:
#   Resend (recommended): SMTP_HOST=smtp.resend.com  SMTP_USERNAME=resend  SMTP_PASSWORD=<api key>
#   AWS SES:              SMTP_HOST=email-smtp.<region>.amazonaws.com  (SMTP credentials)
#   Brevo:                SMTP_HOST=smtp-relay.brevo.com
#   SendGrid:             SMTP_HOST=smtp.sendgrid.net  SMTP_USERNAME=apikey
# Leave empty to disable email — deliveries then fail visibly (never silently).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Platform <noreply@example.com>

# Observability (optional — OTEL)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# Feature flags
FEATURE_FLAGS_PROVIDER=static
FEATURE_FLAGS_JSON={"billing.outbox.enabled":true,"idempotency.enforced":true,"deployments.multi_instance.enabled":false}
UNLEASH_URL=
UNLEASH_API_TOKEN=
UNLEASH_APP_NAME=platform-api
UNLEASH_ENVIRONMENT=development
UNLEASH_POLL_INTERVAL_SECS=15

# Platform internal token (for worker → API calls like deploy)
PLATFORM_INTERNAL_TOKEN=
PGBOUNCER_ADMIN_PASSWORD=

# Platform admin allowlists (control the shared inference-instance fleet and
# other platform/infrastructure admin endpoints). A tenant Owner is NOT a
# platform admin. Comma-separated; BOTH empty = nobody is admin (deny-all).
# PLATFORM_ADMIN_USER_IDS matches the auth subject (JWT `sub`); always available.
# PLATFORM_ADMIN_EMAILS matches the token's email claim (requires the Clerk JWT
# template to include `email`).
PLATFORM_ADMIN_USER_IDS=
PLATFORM_ADMIN_EMAILS=

# ───────────────────────────────────────────
# 2. PYTHON WORKERS (apps/workers)
# ───────────────────────────────────────────
# Workers use the APP_ prefix for all env vars.
# See apps/workers/.env.example for the full list.

# Temporal connection
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TEMPORAL_TASK_QUEUE=ml-pipeline

# Database (same Postgres as API)
APP_DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/platform

# Redis
APP_REDIS_URL=redis://localhost:6379

# S3 / Object Storage
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=platform-dev
APP_S3_REGION=us-east-1

# LLM API — platform-wide defaults (per-tenant settings via API take priority)
APP_LLM_API_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_MAX_TOKENS=2000

# Platform API (for worker → API callbacks)
APP_PLATFORM_API_URL=http://localhost:8000
APP_PLATFORM_INTERNAL_TOKEN=

# vLLM inference server
APP_VLLM_API_URL=http://localhost:8080

# HuggingFace (for model downloads during training)
APP_HF_TOKEN=

# Training config
APP_MODEL_CACHE_DIR=/tmp/model_cache
APP_WORKER_MODE=all          # all | main | gpu

# GPU compute provider: "local" (worker's own GPU) | "modal" (serverless)
APP_GPU_PROVIDER=local
# Modal credentials (only needed when APP_GPU_PROVIDER=modal)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Cloud GPU (Modal) — only used when APP_GPU_PROVIDER=modal
APP_MODAL_APP_NAME=platform-training
APP_MODAL_FUNCTION_NAME=train
APP_MODAL_SECRET_NAME=platform-training-secrets
APP_MODAL_POLL_INTERVAL_SECS=15

# Activity timeouts — increase for slow hardware or very large models
APP_TIMEOUT_PARSE_MINUTES=10
APP_TIMEOUT_CHUNK_MINUTES=10
APP_TIMEOUT_GENERATE_PAIRS_MINUTES=30
APP_TIMEOUT_BUILD_DATASET_MINUTES=15
APP_TIMEOUT_TRAIN_HOURS=6
APP_TIMEOUT_TRAIN_ITERATIVE_HOURS=4
APP_TIMEOUT_HOLDOUT_EVAL_HOURS=1
APP_TIMEOUT_EVAL_HOURS=1
APP_TIMEOUT_EXPORT_HOURS=2

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text           # json (production) | text (local dev)

# ───────────────────────────────────────────
# 3. FRONTEND (apps/web — .env.local)
# ───────────────────────────────────────────
# Next.js uses NEXT_PUBLIC_ prefix for client-side vars.
# Copy these to apps/web/.env.local for local dev.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MyApp
