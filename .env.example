# ===========================================
# Platform — Master Environment Variables
# Copy to .env and fill in values
# ===========================================
#
# This file documents EVERY env var across all services.
# For local dev, copy this to .env at the project root.
# For production, inject these as environment variables
# into each container (see docker-compose.prod.yml).

# ───────────────────────────────────────────
# 1. API SERVER (Rust — crates/api)
# ───────────────────────────────────────────

# App identity
APP_NAME=MyApp
ENVIRONMENT=development     # development | staging | production
LOG_LEVEL=debug             # trace | debug | info | warn | error
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgres://platform:platform_dev@localhost:5432/platform
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://localhost:6379

# S3 / Object Storage
# For local dev: MinIO. For production: AWS S3 or Cloudflare R2.
# Set S3_ENDPOINT="" (empty) to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=platform-dev
S3_REGION=us-east-1

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# vLLM inference server (for deployed model serving)
VLLM_API_URL=http://localhost:8080

# vLLM circuit breaker
VLLM_CB_FAILURE_THRESHOLD=5
VLLM_CB_RECOVERY_TIMEOUT_SECS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=200

# Security headers
SECURITY_CSP_POLICY=default-src 'self'
SECURITY_HSTS_MAX_AGE=31536000

# Stripe billing (optional — leave empty to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Observability (optional — OTEL)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# Platform internal token (for worker → API calls like deploy)
PLATFORM_INTERNAL_TOKEN=

# ───────────────────────────────────────────
# 2. PYTHON WORKERS (apps/workers)
# ───────────────────────────────────────────
# Workers use the APP_ prefix for all env vars.
# See apps/workers/.env.example for the full list.

# Temporal connection
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TEMPORAL_TASK_QUEUE=ml-pipeline

# Database (same Postgres as API)
APP_DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/platform

# Redis
APP_REDIS_URL=redis://localhost:6379

# S3 / Object Storage
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_BUCKET=platform-dev
APP_S3_REGION=us-east-1

# LLM API — platform-wide defaults (per-tenant settings via API take priority)
APP_LLM_API_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_MAX_TOKENS=2000

# Platform API (for worker → API callbacks)
APP_PLATFORM_API_URL=http://localhost:8000
APP_PLATFORM_INTERNAL_TOKEN=

# vLLM inference server
APP_VLLM_API_URL=http://localhost:8080

# HuggingFace (for model downloads during training)
APP_HF_TOKEN=

# Training config
APP_MODEL_CACHE_DIR=/tmp/model_cache
APP_WORKER_MODE=all          # all | main | gpu

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text           # json (production) | text (local dev)

# ───────────────────────────────────────────
# 3. FRONTEND (apps/web — .env.local)
# ───────────────────────────────────────────
# Next.js uses NEXT_PUBLIC_ prefix for client-side vars.
# Copy these to apps/web/.env.local for local dev.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MyApp
